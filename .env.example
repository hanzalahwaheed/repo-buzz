# Server only. Never prefix this with VITE_ or put it in browser code.
GITHUB_TOKEN=replace_with_your_server_side_github_token
# Persist this directory/volume when deploying.
DATABASE_PATH=./data/repobuzz.sqlite
CACHE_TTL_HOURS=6
REFRESH_COOLDOWN_MINUTES=5
PORT=3001
HOST=127.0.0.1

# Neon Postgres. Set either name; DATABASE_URL wins when both are present.
# Leave both unset to use the local SQLite file at DATABASE_PATH.
POSTGRES_URL=postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
